---
import { siteName, t, otherLocale, type Locale } from '../lib/i18n';

interface Props {
	lang: Locale;
	section: string;
	/** Explicit override for where the language toggle links to. Falls back
	 * to this section's index in the other language when omitted. */
	toggleHref?: string;
}

const { lang, section, toggleHref: toggleHrefOverride } = Astro.props;
const base = import.meta.env.BASE_URL;
const other = otherLocale(lang);
const copy = t(lang);

// "O knize" isn't its own page — it's a section on the homepage — so it
// gets a full-path anchor href (works when clicked from any page) instead
// of a `section`-matched route, and never carries aria-current="page".
const NAV = [
	{ href: `${base}${lang}/`, label: copy.nav.home, current: section === '' },
	{ href: `${base}${lang}/#o-knize`, label: copy.nav.oKnize, current: false },
	{ href: `${base}${lang}/kostovy-verse/`, label: copy.nav.kostovyVerse, current: section === 'kostovy-verse/' },
	{
		href: `${base}${lang}/veronicina-tvorba/`,
		label: copy.nav.veronicinaTvorba,
		current: section === 'veronicina-tvorba/',
	},
	{ href: `${base}${lang}/horoskop/`, label: copy.nav.horoskop, current: section === 'horoskop/' },
];

const toggleHref = toggleHrefOverride ?? `${base}${other}/${section}`;
---

<header class="site-header">
	<div class="container inner">
		<a class="logo" href={`${base}${lang}/`}>{siteName}</a>
		<nav aria-label={lang === 'cs' ? 'Hlavní navigace' : 'Main navigation'}>
			{
				NAV.map((item) => (
					<a href={item.href} aria-current={item.current ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
			<a class="lang-toggle" href={toggleHref} hreflang={other}>
				{copy.nav.langToggleTo}
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 2px dashed var(--ink);
		background: var(--paper);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		padding-block: 22px;
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 24px;
		text-decoration: none;
		color: var(--ink);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
	}
	nav a {
		font-family: var(--font-mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		text-decoration: none;
		color: var(--ink);
		border-bottom: 2px solid transparent;
		padding-bottom: 2px;
	}
	nav a:hover {
		color: var(--teal);
	}
	nav a[aria-current='page'] {
		color: var(--teal);
		border-bottom-color: var(--teal);
	}
	.lang-toggle {
		color: var(--ink-soft);
		border: 1px solid var(--rule);
		padding: 3px 8px;
	}
	.lang-toggle:hover {
		color: var(--teal);
		border-color: var(--teal);
	}
</style>
