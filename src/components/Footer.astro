---
import Newsletter from './Newsletter.astro';
import { t, type Locale } from '../lib/i18n';
import broucekIcon from '../assets/ilustrace/vinetka_13.png';
import { Image } from 'astro:assets';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang).footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<Image class="stamp" src={broucekIcon} alt="" width={40} loading="lazy" />
		<Newsletter lang={lang} variant="teal" />
		<p class="copyright">© {year} {copy.copyright} · ALEFUJ!</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: var(--paper);
		padding: 56px 0 32px;
	}
	.stamp {
		height: 34px;
		width: auto;
		margin-bottom: 20px;
		opacity: 0.85;
	}
</style>
