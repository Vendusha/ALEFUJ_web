---
import Newsletter from './Newsletter.astro';
import { t, siteName, type Locale } from '../lib/i18n';
import broucekIcon from '../assets/ilustrace/vinetka_13.png';
import { Image } from 'astro:assets';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang).footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<Image class="stamp" src={broucekIcon} alt="" aria-hidden="true" width={40} loading="lazy" />
		<Newsletter lang={lang} variant="teal" />
		<p class="profiles">
			{copy.profilesLabel}{' '}
			<a rel="me noopener noreferrer" target="_blank" href="https://www.linkedin.com/in/vendula-subert-425a9184"
				>LinkedIn</a
			>{' '}
			·{' '}
			<a
				rel="me noopener noreferrer"
				target="_blank"
				href="https://www.researchgate.net/profile/Vendula-Subert">ResearchGate</a
			>{' '}
			·{' '}
			<a rel="me noopener noreferrer" target="_blank" href="https://www.youtube.com/@vendulasubert"
				>YouTube</a
			>{' '}
			·{' '}
			<a rel="me noopener noreferrer" target="_blank" href={`https://vendulasubert.cz/${lang}/`}
				>vendulasubert.cz</a
			>
		</p>
		<p class="copyright">
			© {year}
			<a rel="me" href={lang === 'cs' ? 'https://vendulasubert.cz/cs/' : 'https://vendulasubert.cz/en/'}>{copy.copyright}</a>
			· {siteName(lang)} ·
			<a href="#toggle-goatcounter">{copy.analyticsToggleLabel}</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: var(--paper);
		padding: 56px 0 32px;
	}
	.stamp {
		height: 34px;
		width: auto;
		margin-bottom: 20px;
		opacity: 0.85;
	}
	.profiles {
		font-family: var(--font-mono);
		font-size: 11px;
		color: #8b998b;
		margin-top: 36px;
	}
	.copyright {
		margin-top: 8px;
	}
</style>
