---
import { t, type Locale } from '../lib/i18n';
import { MAILERLITE_ALEFUJ_FORM_ENDPOINT } from '../lib/i18n';

interface Props {
	lang: Locale;
	variant?: 'teal' | 'cream';
	/** Only set this on one instance per page if you need a #anchor to jump to it. */
	id?: string;
}

const { lang, variant = 'teal', id } = Astro.props;
const copy = t(lang).footer;
const inputId = `newsletter-email-${lang}-${variant}`;
---

<div id={id} class:list={['newsletter', variant]}>
	<h3>{copy.newsletterHeading}</h3>
	<p>{copy.newsletterBody}</p>
	<!--
		Plain HTML form POST to MailerLite's "subscribe" endpoint — no JS embed,
		no tracking script. `fields[email]` is MailerLite's required field
		naming for this endpoint. `ml-submit` marks it as a real form submission
		(matches MailerLite's own non-JS embed code). `target="_blank"` is what
		makes this work without JavaScript while not navigating the visitor away
		from this page: the browser opens MailerLite's own hosted response page
		in a new tab, which — since double opt-in is on for this list — tells
		them to check their email for the confirmation link. That page is
		controlled in the MailerLite dashboard, not in this repo.
	-->
	<form class="newsletter-form" action={MAILERLITE_ALEFUJ_FORM_ENDPOINT} method="post" target="_blank">
		<input type="hidden" name="ml-submit" value="1" />
		<label for={inputId}>{copy.emailLabel}</label>
		<div class="row">
			<input id={inputId} type="email" name="fields[email]" placeholder={copy.emailPlaceholder} required />
			<button type="submit">{copy.submitLabel}</button>
		</div>
	</form>
</div>

<style>
	.newsletter {
		max-width: 460px;
	}
	.newsletter h3 {
		font-family: var(--font-display);
		font-size: 22px;
		margin: 0 0 8px;
	}
	.newsletter.teal h3 {
		color: var(--lime);
	}
	.newsletter p {
		margin: 0 0 16px;
	}
	.newsletter.teal p {
		color: #c9cfc4;
	}
	.newsletter.cream p {
		color: var(--ink-soft);
	}
	.newsletter-form label {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 8px;
	}
	.newsletter.teal label {
		color: #c9cfc4;
	}
	.newsletter.cream label {
		color: var(--ink-soft);
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		max-width: 420px;
	}
	.row input {
		flex: 1;
		min-width: 200px;
		padding: 12px 14px;
		font-family: var(--font-mono);
		font-size: 14px;
	}
	.newsletter.teal .row input {
		border: 2px solid var(--paper);
		background: transparent;
		color: var(--paper);
	}
	.newsletter.teal .row input::placeholder {
		color: #9aa79a;
	}
	.newsletter.cream .row input {
		border: 2px solid var(--ink);
		background: transparent;
		color: var(--ink);
	}
	.row button {
		padding: 12px 20px;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 12px;
		text-transform: uppercase;
		cursor: pointer;
	}
	.newsletter.teal .row button {
		background: var(--lime);
		color: var(--teal-deep);
		border: 2px solid var(--lime);
	}
	.newsletter.teal .row button:hover {
		background: var(--paper);
		border-color: var(--paper);
	}
	.newsletter.cream .row button {
		background: var(--teal);
		color: var(--paper);
		border: 2px solid var(--teal);
	}
	.newsletter.cream .row button:hover {
		background: var(--ink);
		border-color: var(--ink);
	}
</style>
