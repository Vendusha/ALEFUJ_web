---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteName, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	lang: Locale;
	section: string;
	toggleHref?: string;
	title: string;
	description?: string;
}

const { lang, section, toggleHref, title, description } = Astro.props;
const isHome = section === '';
const pageTitle = isHome ? title : `${title} — ${siteName}`;

const otherLang: Locale = lang === 'cs' ? 'en' : 'cs';
const path = Astro.url.pathname;
const csUrl = new URL(path.replace(/^\/en\//, '/cs/'), Astro.site).href;
const enUrl = new URL(path.replace(/^\/cs\//, '/en/'), Astro.site).href;

const ogImageUrl = new URL('/og-image.jpg', Astro.site).href;
const ogImageAlt =
	lang === 'cs'
		? 'Obálka knihy ALEFUJ! — teal ilustrace s brouky'
		: 'Cover of ALEFUJ! — teal illustration with bugs';
const ogLocale = lang === 'cs' ? 'cs_CZ' : 'en_US';
const ogLocaleAlternate = otherLang === 'cs' ? 'cs_CZ' : 'en_US';

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteName,
	url: new URL(`/${lang}/`, Astro.site).href,
	inLanguage: lang === 'cs' ? 'cs-CZ' : 'en-US',
};
const bookJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	name: siteName,
	author: { '@type': 'Person', name: 'Vendula Šubert', url: 'https://vendulasubert.cz/' },
	inLanguage: 'cs',
	genre: lang === 'cs' ? 'humoristický román' : 'comic novel',
	url: new URL(`/${lang}/`, Astro.site).href,
	...(description ? { description } : {}),
};
const jsonLd = isHome ? [websiteJsonLd, bookJsonLd] : [websiteJsonLd];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={Astro.url.href} />
		<link rel="alternate" hreflang="cs" href={csUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={csUrl} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:url" content={Astro.url.href} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header lang={lang} section={section} toggleHref={toggleHref} />
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
