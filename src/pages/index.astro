---
// Static-hosting language redirect: GitHub Pages can't do server-side
// language negotiation, so this always sends visitors to the Czech
// homepage — the primary audience is Czech, and browser-language
// detection was sending some Czech visitors to /en/ unexpectedly. English
// stays fully reachable via the header's language toggle once on the site.
// This is the URL people share, so it carries full metadata itself rather
// than relying on the redirect target's tags (social crawlers don't follow
// the meta refresh).
import { siteName } from '../lib/i18n';

const base = import.meta.env.BASE_URL;
const csHref = `${base}cs/`;
const enHref = `${base}en/`;

const pageTitle = `${siteName} — humoristický román Venduly Šubert`;
const description =
	'Humoristický román Venduly Šubert. Kosťa hledá práci, která dává smysl, Bára pátrá po muži, který anonymně radil Nobelovu výboru.';
const rootUrl = new URL('/', Astro.site).href;
const csUrl = new URL('/cs/', Astro.site).href;
const enUrl = new URL('/en/', Astro.site).href;
const ogImageUrl = new URL('/og-image.jpg', Astro.site).href;
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={rootUrl} />
		<link rel="alternate" hreflang="cs" href={csUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={csUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={rootUrl} />
		<meta property="og:locale" content="cs_CZ" />
		<meta property="og:locale:alternate" content="en_US" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Obálka knihy ALEFUJ! — teal ilustrace s brouky" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Obálka knihy ALEFUJ! — teal ilustrace s brouky" />

		<meta http-equiv="refresh" content={`0; url=${csHref}`} />

		<!-- GoatCounter — see src/layouts/Layout.astro for the full explanation.
		     Measured here too, unlike this page's counterpart on
		     vendulasubert.cz, per explicit request. -->
		{
			!import.meta.env.DEV && (
				<script is:inline data-goatcounter="https://alefuj.goatcounter.com/count" async src="//gc.zgo.at/count.js" />
			)
		}
	</head>
	<body>
		<p><a href={csHref}>Pokračovat v češtině</a> / <a href={enHref}>Continue in English</a></p>
	</body>
</html>
