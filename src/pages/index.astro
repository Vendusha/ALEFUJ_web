---
// Static-hosting language redirect: GitHub Pages can't do server-side
// language negotiation, so this picks a language client-side and redirects.
// Defaults to Czech whenever English isn't clearly preferred, and degrades
// to a plain meta-refresh to /cs/ when JavaScript is unavailable.
import { siteName } from '../lib/i18n';

const base = import.meta.env.BASE_URL;
const csHref = `${base}cs/`;
const enHref = `${base}en/`;
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<title>{siteName}</title>
		<!-- Only takes effect when JavaScript is disabled — otherwise the
		     script below runs first and picks a language. -->
		<noscript>
			<meta http-equiv="refresh" content={`0; url=${csHref}`} />
		</noscript>
		<script is:inline define:vars={{ csHref, enHref }}>
			var preferred = (navigator.languages && navigator.languages[0]) || navigator.language || 'cs';
			var target = preferred.toLowerCase().startsWith('en') ? enHref : csHref;
			window.location.replace(target);
		</script>
	</head>
	<body>
		<noscript>
			<p><a href={csHref}>Pokračovat v češtině</a> / <a href={enHref}>Continue in English</a></p>
		</noscript>
	</body>
</html>
