---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import CzechOnlyNotice from '../../../components/CzechOnlyNotice.astro';
import musicIcon from '../../../assets/ilustrace/vinetka_16.png';
import { t, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang).veronicinaTvorba;

const all = await getCollection('veronicinaTvorba');
const basne = all.filter((e) => e.data.typ === 'basen');
const pisne = all.filter((e) => e.data.typ === 'pisen');
---

<Layout lang={lang} section="veronicina-tvorba/" title={copy.heading} description={copy.heading}>
	<section class="panel panel-cream">
		<div class="container">
			<div class="section-head">
				<Image class="staff" src={musicIcon} alt="" width={140} />
			</div>
			<p class="section-label">Sešit č. 6</p>
			<h2>{copy.heading}</h2>
			{lang === 'en' && <CzechOnlyNotice message={copy.czechOnlyNote} />}
			{
				all.length === 0 ? (
					<p>{copy.empty}</p>
				) : (
					<>
						{basne.length > 0 && (
							<div class="group">
								<h3 class="group-heading">{copy.poemsHeading}</h3>
								<div class="poem-list">
									{basne.map((entry) => (
										<div class="poem">
											<h4>{entry.data.title}</h4>
											<p class="desc">{entry.data.description}</p>
											{entry.data.youtubeId && (
												<div class="video-wrap">
													<iframe
														src={`https://www.youtube.com/embed/${entry.data.youtubeId}`}
														title={entry.data.title}
														loading="lazy"
														allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
														allowfullscreen
													/>
												</div>
											)}
										</div>
									))}
								</div>
							</div>
						)}
						{pisne.length > 0 && (
							<div class="group">
								<h3 class="group-heading">{copy.songsHeading}</h3>
								<div class="song-list">
									{pisne.map((entry) => (
										<div class="song">
											<h4>{entry.data.title}</h4>
											<p class="desc">{entry.data.description}</p>
											{entry.data.youtubeId && (
												<div class="video-wrap">
													<iframe
														src={`https://www.youtube.com/embed/${entry.data.youtubeId}`}
														title={entry.data.title}
														loading="lazy"
														allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
														allowfullscreen
													/>
												</div>
											)}
										</div>
									))}
								</div>
							</div>
						)}
					</>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.section-head {
		margin-bottom: -10px;
	}
	.staff {
		opacity: 0.6;
	}
	.group {
		margin-top: 36px;
	}
	.group-heading {
		font-family: var(--font-mono);
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--teal);
		border-bottom: 1px solid var(--rule);
		padding-bottom: 10px;
		margin: 0 0 24px;
	}
	.poem-list,
	.song-list {
		display: grid;
		gap: 40px;
	}
	.poem h4,
	.song h4 {
		font-family: var(--font-display);
		font-size: 20px;
		margin: 0 0 6px;
	}
	.desc {
		color: var(--ink-soft);
		margin-bottom: 16px;
	}
	.video-wrap {
		position: relative;
		width: 100%;
		max-width: 640px;
		aspect-ratio: 16 / 9;
		border: 2px solid var(--ink);
	}
	.video-wrap iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: none;
	}
</style>
