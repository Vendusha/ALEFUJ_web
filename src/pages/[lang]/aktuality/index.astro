---
import { getAktuality } from '../../../lib/aktuality';
import Layout from '../../../layouts/Layout.astro';
import { t, locales, dateLocale, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang).aktuality;
const base = import.meta.env.BASE_URL;

const updates = await getAktuality(lang);
const dateFormatter = new Intl.DateTimeFormat(dateLocale(lang), { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout lang={lang} section="aktuality/" title={copy.heading} description={copy.heading}>
	<section class="panel panel-cream">
		<div class="container">
			<p class="section-label">Sešit č. 2</p>
			<h2>{copy.heading}</h2>
			{
				updates.length === 0 ? (
					<p>{copy.empty}</p>
				) : (
					<div class="updates">
						{updates.map((post) => (
							<a class="clip update-card" href={`${base}${lang}/aktuality/${post.id}/`}>
								<div class="date">{dateFormatter.format(post.data.date)}</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.summary}</p>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.updates {
		display: grid;
		gap: 22px;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		margin-top: 30px;
	}
	.update-card {
		display: block;
		text-decoration: none;
		color: var(--ink);
		transform: rotate(-0.6deg);
	}
	.update-card:nth-child(even) {
		transform: rotate(0.5deg);
	}
	.update-card .date {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-soft);
	}
	.update-card h3 {
		margin: 8px 0;
	}
	.update-card p {
		margin: 0;
		color: var(--ink-soft);
	}
</style>
