---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import CzechOnlyNotice from '../../../components/CzechOnlyNotice.astro';
import sealIcon from '../../../assets/ilustrace/vinetka_13.png';
import { PRODUCT_TYPE_LABELS } from '../../../lib/site';
import { t, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang).kostovyVerse;

const poems = await getCollection('kostovyVerse');
---

<Layout lang={lang} section="kostovy-verse/" title={copy.heading} description={copy.intro}>
	<section class="panel panel-teal">
		<div class="container">
			<h2>{copy.heading}</h2>
			<p class="intro">{copy.intro}</p>
			{lang === 'en' && <CzechOnlyNotice message={copy.czechOnlyNote} />}
			{
				poems.length === 0 ? (
					<p>{copy.empty}</p>
				) : (
					<div class="verse-grid">
						{poems.map((poem) => (
							<div class="verse-ticket">
								<div class="seal">
									<Image src={sealIcon} alt="" width={34} />
								</div>
								<span class="tag">{PRODUCT_TYPE_LABELS[poem.data.productType]}</span>
								<h3>{poem.data.title}</h3>
								{poem.data.image && <Image class="poem-image" src={poem.data.image} alt="" width={320} />}
								<p class="poem">{poem.data.text}</p>
							</div>
						))}
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.intro {
		max-width: 60ch;
		color: #dce7de;
		margin-top: -12px;
		margin-bottom: 34px;
	}
	.verse-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 24px;
	}
	.verse-ticket {
		border: 2px dashed var(--paper);
		padding: 22px;
		position: relative;
		background: var(--teal-deep);
	}
	.verse-ticket h3 {
		margin: 12px 0 10px;
	}
	.poem-image {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--paper);
		margin-bottom: 14px;
	}
	.poem {
		font-size: 15px;
		color: #dfeee0;
		font-style: italic;
		line-height: 1.7;
	}
	.seal {
		position: absolute;
		top: -14px;
		right: -10px;
		width: 54px;
		height: 54px;
		border-radius: 50%;
		background: var(--lime);
		display: flex;
		align-items: center;
		justify-content: center;
		transform: rotate(8deg);
	}
</style>
