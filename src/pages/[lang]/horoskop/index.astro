---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CzechOnlyNotice from '../../../components/CzechOnlyNotice.astro';
import { ZODIAC_SIGNS } from '../../../content.config';
import { ZODIAC_SIGN_LABELS } from '../../../lib/site';
import { getFirstParagraph, autoExcerpt } from '../../../lib/horoskop';
import { t, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang).horoskop;

const PLACEHOLDER_TEXT = '[doplním]';

const entries = await getCollection('horoskop');
const bySign = new Map(entries.map((e) => [e.data.sign, e]));

// One entry per sign in canonical order, whether or not a real file exists
// for it yet — a missing file is treated the same as an explicit
// `draft: true` (see the schema comment in content.config.ts), so the page
// always builds with all twelve slots present.
const signs = await Promise.all(
	ZODIAC_SIGNS.map(async (sign) => {
		const label = ZODIAC_SIGN_LABELS[sign];
		const entry = bySign.get(sign);
		if (!entry || entry.data.draft) {
			return { sign, label, isDraft: true as const, excerpt: PLACEHOLDER_TEXT };
		}
		const { Content } = await render(entry);
		const excerpt = entry.data.excerpt ?? autoExcerpt(getFirstParagraph(entry.body ?? ''));
		return { sign, label, isDraft: false as const, excerpt, Content };
	}),
);
---

<Layout lang={lang} section="horoskop/" title={copy.heading} description={copy.heading}>
	<section class="panel panel-teal">
		<div class="container">
			<p class="section-label" style="color: var(--lime);">Sešit č. 7</p>
			<h2>{copy.heading}</h2>
			{lang === 'en' && <CzechOnlyNotice message={copy.czechOnlyNote} />}
			<div id="featured-horoscope">
				<p class="loading">{copy.loading}</p>
				{
					signs.map((s) => {
						const Content = 'Content' in s ? s.Content : undefined;
						return (
							<article class="featured-entry" data-sign={s.sign} hidden>
								<p class="featured-sign-label">{s.label}</p>
								{s.isDraft || !Content ? (
									<p class="fallback">{copy.fallback}</p>
								) : (
									<div class="prose">
										<Content />
									</div>
								)}
							</article>
						);
					})
				}
			</div>
		</div>
	</section>

	<section class="panel panel-cream">
		<div class="container">
			<p class="section-label">{copy.otherSignsHeading}</p>
			<div class="signs-grid" id="signs-grid">
				{
					signs.map((s) => {
						const Content = 'Content' in s ? s.Content : undefined;
						return (
							<div class="sign-tile" data-sign={s.sign}>
								<button class="tile-toggle" type="button" aria-expanded="false">
									<h3>{s.label}</h3>
									<p class="excerpt">{s.excerpt}</p>
								</button>
								<div class="tile-full prose" hidden>
									{s.isDraft || !Content ? <p>{copy.fallback}</p> : <Content />}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>
	</section>
</Layout>

<script>
	import { getFeaturedSign } from '../../../lib/horoskop';

	function initFeatured() {
		const container = document.getElementById('featured-horoscope');
		if (!container) return;
		const loading = container.querySelector('.loading');

		const sign = getFeaturedSign(new Date());

		const entry = container.querySelector<HTMLElement>(`.featured-entry[data-sign="${sign}"]`);
		if (entry) entry.hidden = false;
		loading?.remove();

		// The featured sign's own tile is already shown in full above —
		// don't show it a second time in the grid below.
		const tile = document.querySelector<HTMLElement>(`.sign-tile[data-sign="${sign}"]`);
		if (tile) tile.hidden = true;
	}

	function initAccordion() {
		document.querySelectorAll<HTMLButtonElement>('.tile-toggle').forEach((btn) => {
			btn.addEventListener('click', () => {
				const full = btn.closest('.sign-tile')?.querySelector<HTMLElement>('.tile-full');
				if (!full) return;
				const expanded = btn.getAttribute('aria-expanded') === 'true';
				btn.setAttribute('aria-expanded', String(!expanded));
				full.hidden = expanded;
			});
		});
	}

	initFeatured();
	initAccordion();
</script>

<style>
	.loading,
	.fallback {
		color: #dce7de;
		font-style: italic;
	}
	.featured-sign-label {
		font-family: var(--font-mono);
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--lime);
		margin: 0 0 16px;
	}
	#featured-horoscope :global(.prose) {
		max-width: 68ch;
	}
	#featured-horoscope :global(.prose p) {
		color: #eef4ee;
		font-size: 17px;
	}
	/* The trailing italicized aside is a whole paragraph that's entirely
	   emphasis — a different, more footnote-like register than the main
	   horoscope text, so it gets its own quieter treatment. */
	#featured-horoscope :global(.prose p:has(> em:only-child)) {
		margin-top: 1.6em;
		padding-top: 1.2em;
		border-top: 1px dashed rgba(215, 222, 92, 0.4);
		font-size: 15px;
		color: #b9c9bb;
	}

	.signs-grid {
		display: grid;
		gap: 18px;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		margin-top: 30px;
	}
	.sign-tile {
		background: var(--paper-soft);
		border: 1px solid var(--rule);
	}
	.tile-toggle {
		display: block;
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		padding: 18px 20px;
		cursor: pointer;
		font: inherit;
		color: inherit;
	}
	.tile-toggle h3 {
		font-family: var(--font-display);
		font-size: 17px;
		margin: 0 0 8px;
		color: var(--teal);
	}
	.tile-toggle .excerpt {
		margin: 0;
		font-size: 14px;
		color: var(--ink-soft);
		line-height: 1.6;
	}
	.tile-toggle[aria-expanded='true'] h3 {
		color: var(--ink);
	}
	.tile-toggle[aria-expanded='true'] .excerpt {
		display: none;
	}
	.tile-full {
		padding: 0 20px 20px;
	}
	.tile-full :global(p) {
		font-size: 15px;
		color: var(--ink-soft);
		line-height: 1.65;
	}
	.tile-full :global(p:has(> em:only-child)) {
		margin-top: 1.4em;
		padding-top: 1em;
		border-top: 1px dashed var(--rule);
		font-size: 13.5px;
		font-style: normal;
	}
</style>
