---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { loadPage } from '../../../lib/pages';
import { locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;

const { entry, shownLang } = await loadPage('ochrana-osobnich-udaju', lang);
const { Content } = await render(entry);
---

<Layout
	lang={lang}
	section="ochrana-osobnich-udaju/"
	title={entry.data.title}
	description={entry.data.description}
>
	<section class="panel panel-cream">
		<div class="container">
			<h1 class="page-title">{entry.data.title}</h1>
			{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}
			<div class="prose">
				<Content />
			</div>
		</div>
	</section>
</Layout>

<style>
	.prose {
		padding: 8px 0 48px;
	}
	.prose :global(h2) {
		font-size: 20px;
		margin-top: 1.8em;
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
</style>
