---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import { loadPage } from '../../lib/pages';
import frontCover from '../../assets/ilustrace/front-cover-teal.png';
import houseSketch1 from '../../assets/ilustrace/house-sketch-01.png';
import houseSketch2 from '../../assets/ilustrace/house-sketch-02.png';
import magnifyingGlass from '../../assets/ilustrace/vinetka_10.png';
import { t, locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const base = import.meta.env.BASE_URL;
const copy = t(lang);

const { entry: homeEntry, shownLang: homeShownLang } = await loadPage('home', lang);
const { Content: HomeContent } = await render(homeEntry);

const { entry: oKnizeEntry, shownLang: oKnizeShownLang } = await loadPage('o-knize', lang);
const { Content: OKnizeContent } = await render(oKnizeEntry);

const { entry: creditsEntry, shownLang: creditsShownLang } = await loadPage('credits', lang);
const { Content: CreditsContent } = await render(creditsEntry);

const READ_NOW = [
	{ href: 'horoskop/', ...copy.home.readNowHoroskop },
	{ href: 'kostovy-verse/', ...copy.home.readNowVerse },
	{ href: 'veronicina-tvorba/', ...copy.home.readNowTvorba },
];
---

<Layout lang={lang} section="" title={homeEntry.data.title} description={homeEntry.data.description}>
	<section class="panel panel-cream opening">
		<div class="container hero-grid">
			<div class="hero-copy">
				<h1>{copy.home.heading}</h1>
				{homeShownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={homeShownLang} />}
				<div class="prose">
					<HomeContent />
				</div>
			</div>
			<div class="hero-cover">
				<Image src={frontCover} alt="Obálka knihy ALEFUJ!" widths={[400, 700, 1000]} sizes="(min-width: 760px) 40vw, 80vw" />
			</div>
		</div>
		<div class="container house-divider">
			<Image src={houseSketch1} alt="" width={200} />
			<Image src={houseSketch2} alt="" width={260} />
		</div>
	</section>

	<section id="o-knize" class="panel panel-cream o-knize">
		<div class="container">
			<p class="section-label">Sešit č. 2</p>
			<div class="o-knize-heading-row">
				<h2>{copy.home.oKnizeHeading}</h2>
				<Image class="accent" src={magnifyingGlass} alt="" width={64} />
			</div>
			<div class="prose">
				{oKnizeShownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={oKnizeShownLang} />}
				<OKnizeContent />
			</div>
		</div>
	</section>

	<section class="panel panel-teal read-now">
		<div class="container">
			<h2>{copy.home.readNowHeading}</h2>
			<div class="link-grid">
				{
					READ_NOW.map((s) => (
						<a class="link-card" href={`${base}${lang}/${s.href}`}>
							<h3>{s.title}</h3>
							<p>{s.desc}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="panel panel-cream">
		<div class="container newsletter-inline">
			<Newsletter lang={lang} variant="cream" />
		</div>
	</section>

	<section class="panel panel-cream credits">
		<div class="container prose">
			{creditsShownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={creditsShownLang} />}
			<CreditsContent />
		</div>
	</section>
</Layout>

<style>
	.opening {
		padding-top: 48px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 48px;
		align-items: center;
	}
	.hero-copy h1 {
		margin-bottom: 20px;
	}
	.hero-cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 6px solid var(--paper-soft);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
		transform: rotate(2deg);
	}
	@media (max-width: 760px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
		.hero-cover {
			order: -1;
			max-width: 300px;
			margin: 0 auto;
		}
	}

	.read-now {
		padding-top: 56px;
	}
	.link-grid {
		display: grid;
		gap: 20px;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		margin-top: 30px;
	}
	.link-card {
		display: block;
		text-decoration: none;
		color: var(--paper);
		border: 2px dashed var(--paper);
		padding: 24px;
		border-radius: 4px;
	}
	.link-card:hover {
		border-color: var(--lime);
		background: rgba(255, 255, 255, 0.05);
	}
	.link-card h3 {
		margin: 0 0 10px;
		color: var(--lime);
	}
	.link-card p {
		margin: 0;
		color: #d8e3d5;
		font-size: 15px;
		line-height: 1.6;
	}

	.newsletter-inline {
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		padding-block: 40px;
	}

	.o-knize {
		/* Offsets the anchor scroll target so a fixed/sticky header (present
		   or future) never lands flush against the heading. */
		scroll-margin-top: 90px;
		padding-top: 20px;
		padding-bottom: 44px;
	}
	.o-knize .prose {
		max-width: 62ch;
	}
	.o-knize-heading-row {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.o-knize-heading-row h2 {
		margin: 0;
	}
	.o-knize-heading-row .accent {
		flex-shrink: 0;
		width: 64px;
		height: auto;
		opacity: 0.85;
		transform: rotate(-6deg);
	}
	/* The closing pitch line gets visual weight, as the section's payoff. */
	.o-knize .prose :global(p:last-of-type) {
		margin-top: 1.4em;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 22px;
		color: var(--teal);
	}

	.credits {
		padding-top: 20px;
		padding-bottom: 60px;
	}
	.credits .prose {
		font-size: 15px;
		color: var(--ink-soft);
		max-width: 60ch;
	}
	.credits :global(p) {
		margin-bottom: 0.9em;
	}
</style>
