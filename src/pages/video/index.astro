---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import coffeeIcon from '../../assets/ilustrace/vinetka_31.png';
import { INTRO_VIDEO_ID_PLACEHOLDER } from '../../lib/site';
---

<Layout section="video/" title="Video" description="Krátké video o knize ALEFUJ!.">
	<section class="panel panel-cream">
		<div class="container">
			<p class="section-label">Sešit č. 4</p>
			<h2>Video</h2>
			<div class="video-wrap">
				<iframe
					src={`https://www.youtube.com/embed/${INTRO_VIDEO_ID_PLACEHOLDER}`}
					title="ALEFUJ! — video"
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			</div>
			<div class="caption-row">
				<Image class="marg" src={coffeeIcon} alt="" width={64} />
				<p class="caption">Krátké video o knize. <em>(Zástupný text — nahraď skutečným popiskem.)</em></p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.video-wrap {
		position: relative;
		width: 100%;
		max-width: 840px;
		aspect-ratio: 16 / 9;
		margin-top: 26px;
		border: 2px solid var(--ink);
	}
	.video-wrap iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: none;
	}
	.caption-row {
		display: flex;
		align-items: center;
		gap: 16px;
		max-width: 840px;
		margin-top: 20px;
	}
	.marg {
		flex-shrink: 0;
		transform: rotate(-6deg);
		opacity: 0.85;
	}
	.caption {
		margin: 0;
		color: var(--ink-soft);
	}
	.caption em {
		font-style: italic;
	}
</style>
